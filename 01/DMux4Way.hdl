// File name: projects/01/DMux4Way.hdl

/**
 * 4-way demultiplexor:
 * {a, b, c, d} = {in, 0, 0, 0} if sel == 00
 *                {0, in, 0, 0} if sel == 01
 *                {0, 0, in, 0} if sel == 10
 *                {0, 0, 0, in} if sel == 11
 */

CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    // 第一層：利用最高位元 sel[1]，將 in 分流到「上半部(a,b)」或「下半部(c,d)」
    DMux(in=in, sel=sel[1], a=outAB, b=outCD);

    // 第二層：利用最低位元 sel[0]，決定最終單一輸出端點
    DMux(in=outAB, sel=sel[0], a=a, b=b);
    DMux(in=outCD, sel=sel[0], a=c, b=d);
}