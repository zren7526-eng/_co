// File name: projects/01/Or.hdl

 /**
 * Or gate:
 * out = 1 if (a == 1 or b == 1)
 *       0 otherwise
 */

CHIP Or {
    IN a, b;
    OUT out;

    PARTS:
    // 將 a 反相
    Not(in=a, out=notA);
    
    // 將 b 反相
    Not(in=b, out=notB);
    
    // 兩者再進行 Nand 運算
    Nand(a=notA, b=notB, out=out);
}