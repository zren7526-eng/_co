// File name: projects/02/Adder16.hdl

/**
 * Adds two 16-bit values.
 * The most significant carry bit is ignored.
 */

CHIP Add16 {
    IN a[16], b[16];
    OUT out[16];

    PARTS:
    HalfAdder(a=a[0], b=b[0], sum=out[0], carry=c0);
    FullAdder(a=a[1], b=b[1], c=c0, sum=out[1], carry=c1);
    FullAdder(a=a[2], b=b[2], c=c1, sum=out[2], carry=c2);
    FullAdder(a=a[3], b=b[3], c=c2, sum=out[3], carry=c3);
    FullAdder(a=a[4], b=b[4], c=c3, sum=out[4], carry=c4);
    FullAdder(a=a[5], b=b[5], c=c4, sum=out[5], carry=c5);
    FullAdder(a=a[6], b=b[6], c=c5, sum=out[6], carry=c6);
    FullAdder(a=a[7], b=b[7], c=c6, sum=out[7], carry=c7);
    FullAdder(a=a[8], b=b[8], c=c7, sum=out[8], carry=c8);
    FullAdder(a=a[9], b=b[9], c=c8, sum=out[9], carry=c9);
    FullAdder(a=a[10], b=b[10], c=c9, sum=out[10], carry=c10);
    FullAdder(a=a[11], b=b[11], c=c10, sum=out[11], carry=c11);
    FullAdder(a=a[12], b=b[12], c=c11, sum=out[12], carry=c12);
    FullAdder(a=a[13], b=b[13], c=c12, sum=out[13], carry=c13);
    FullAdder(a=a[14], b=b[14], c=c13, sum=out[14], carry=c14);
    FullAdder(a=a[15], b=b[15], c=c14在 Nand2Tetris Project 02 中，`Add16` 是透過串接加法器來實現 16 位元二進位加法（Ripple-Carry Adder 架構）。

**實作思路**

* **最低位（bit 0）**：因為沒有前一位的進位輸入，可以直接使用一個半加器（`HalfAdder`），或者使用全加器（`FullAdder`）並將進位輸入 `c` 接為 `false`。
* **其餘各位（bit 1 到 15）**：每一位都需要將輸入 $a[i]$、$b[i]$ 與前一級產生的進位結合，因此使用 15 個全加器（`FullAdder`）依次串接。
* **最高位進位**：註釋說明最高位的溢出進位直接忽略，因此最後一個加法器的進位輸出不需要接出，保持未連接即可（或者留空）。

---

**HDL 實作程式碼**

```hdl
CHIP Add16 {
    IN a[16], b[16];
    OUT out[16];

    PARTS:
    // 最低位元可以使用 HalfAdder
    HalfAdder(a=a[0], b=b[0], sum=out[0], carry=c1);

    // 依序使用 FullAdder 串接每一位的進位
    FullAdder(a=a[1],  b=b[1],  c=c1,  sum=out[1],  carry=c2);
    FullAdder(a=a[2],  b=b[2],  c=c2,  sum=out[2],  carry=c3);
    FullAdder(a=a[3],  b=b[3],  c=c3,  sum=out[3],  carry=c4);
    FullAdder(a=a[4],  b=b[4],  c=c4,  sum=out[4],  carry=c5);
    FullAdder(a=a[5],  b=b[5],  c=c5,  sum=out[5],  carry=c6);
    FullAdder(a=a[6],  b=b[6],  c=c6,  sum=out[6],  carry=c7);
    FullAdder(a=a[7],  b=b[7],  c=c7,  sum=out[7],  carry=c8);
    FullAdder(a=a[8],  b=b[8],  c=c8,  sum=out[8],  carry=c9);
    FullAdder(a=a[9],  b=b[9],  c=c9,  sum=out[9],  carry=c10);
    FullAdder(a=a[10], b=b[10], c=c10, sum=out[10], carry=c11);
    FullAdder(a=a[11], b=b[11], c=c11, sum=out[11], carry=c12);
    FullAdder(a=a[12], b=b[12], c=c12, sum=out[12], carry=c13);
    FullAdder(a=a[13], b=b[13], c=c13, sum=out[13], carry=c14);
    FullAdder(a=a[14], b=b[14], c=c14, sum=out[14], carry=c15);

    // 最高位元產生的進位不需輸出，不接 carry 即可
    FullAdder(a=a[15], b=b[15], c=c15, sum=out[15], carry=drop);
}